# ─────────────────────────────────────────────────────────────────
# BPSCVS / EventLens AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────────

# ── Supabase (Required) ──────────────────────────────────────────
# Sign up at https://supabase.com (Free), create a new project,
# then go to Settings > API to find these values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Session Security (Required for Production) ──────────────────
# Generate a random 32+ char string: https://generate-secret.vercel.app/32
AUTH_SECRET=replace-with-a-random-32-character-secret

# ── Cloudflare R2 Object Storage (Recommended for Photos) ───────
# 1. Cloudflare Dashboard > R2 > Create bucket (e.g. bpscvs-photos)
# 2. Settings > Public access > Custom domain (or enable r2.dev subdomain)
# 3. Manage R2 API Tokens > Create API Token (Permissions: Object Read & Write)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-s3-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-s3-secret-access-key
R2_BUCKET_NAME=bpscvs-photos
R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# ── Admin Credentials (Optional — defaults shown) ───────────────
# These can be changed here or via Cloudflare environment variables.
ADMIN_EMAIL=admin@bpscvs.org
ADMIN_PASSWORD=bpscvs@2026

# ── Photographer Credentials (Optional — defaults shown) ────────
PHOTOGRAPHER_EMAIL=lens.rohan@bpscvs.org
PHOTOGRAPHER_PASSWORD=photo@2026

